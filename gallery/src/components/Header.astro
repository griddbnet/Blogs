<header
    class="w-full bg-white border-b border-gray-100 shadow-sm sticky top-0 z-50"
>
    <div
        class="max-w-[1440px] mx-auto px-6 h-20 flex items-center justify-between"
    >
        <a href="https://griddb.net" class="flex items-center gap-2 group">
            <img
                src="/favicon.svg"
                alt="GridDB Logo"
                class="w-8 h-8 object-contain"
            />
            <div class="flex items-baseline gap-1 text-xl font-sans">
                <span class="font-bold text-gray-700 tracking-tight"
                    >GridDB</span
                >
                <span class="text-cyan-500 italic font-medium">Developers</span>
            </div>
        </a>

        <nav class="hidden lg:flex items-center gap-8">
            <div
                class="group relative flex items-center gap-1 cursor-pointer text-gray-600 hover:text-cyan-600 font-medium transition-colors py-6"
            >
                <span>Docs</span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 mt-0.5 opacity-70 group-hover:rotate-180 transition-transform"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
                >

                <div
                    class="absolute top-full left-0 pt-2 w-48 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 transform translate-y-2 group-hover:translate-y-0 z-50"
                >
                    <div
                        class="bg-white border border-gray-100 shadow-xl rounded-md overflow-hidden py-1 text-sm text-gray-600"
                    >
                        <a
                            href="https://docs.griddb.net/"
                            class="block px-4 py-2 hover:bg-cyan-50 hover:text-cyan-600"
                            >Docs</a
                        >
                        <a
                            href="https://griddb.net/en/faq"
                            class="block px-4 py-2 hover:bg-cyan-50 hover:text-cyan-600"
                            >FAQ</a
                        >
                    </div>
                </div>
            </div>

            <a
                href="https://griddb.net/en/blogs/"
                class="text-gray-600 hover:text-cyan-600 font-medium transition-colors"
                >Blogs</a
            >

            <div
                class="group relative flex items-center gap-1 cursor-pointer text-gray-600 hover:text-cyan-600 font-medium transition-colors"
            >
                <a href="https://griddb.net/en/resources"
                    ><span>Resources</span></a
                >
            </div>

            <div
                class="group relative flex items-center gap-1 cursor-pointer text-gray-600 hover:text-cyan-600 font-medium transition-colors"
            >
                <span>Community</span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 mt-0.5 opacity-70"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
                >

                <div
                    class="absolute top-full left-0 pt-2 w-48 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 transform translate-y-2 group-hover:translate-y-0 z-50"
                >
                    <div
                        class="bg-white border border-gray-100 shadow-xl rounded-md overflow-hidden py-1 text-sm text-gray-600"
                    >
                        <a
                            href="https://griddb.net/en/community"
                            class="block px-4 py-2 hover:bg-cyan-50 hover:text-cyan-600"
                            >Community Page</a
                        >
                        <a
                            href="https://forum.griddb.net"
                            class="block px-4 py-2 hover:bg-cyan-50 hover:text-cyan-600"
                            >GridDB Forum</a
                        >
                    </div>
                </div>
            </div>
        </nav>

        <div class="flex items-center gap-6">
            <a
                href="https://griddb.net/en/downloads"
                class="bg-gradient-to-r from-cyan-400 to-cyan-500 hover:from-cyan-500 hover:to-cyan-600 text-white font-semibold px-6 py-2 rounded shadow-md transition-all transform hover:scale-[1.02]"
            >
                Download
            </a>
        </div>
    </div>
</header>
